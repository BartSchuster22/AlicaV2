              "type": "object"
            },
            "kind": "unary",
            "name": "put",
            "output": {
              "additionalProperties": false,
              "properties": {
                "stored": {
                  "const": true,
                  "type": "boolean"
                }
              },
              "required": [
                "stored"
              ],
              "type": "object"
            }
          },
          {
            "idempotency": "none",
            "input": {
              "additionalProperties": false,
              "properties": {
