    "definitions": [
      {
        "apiVersion": "catalog.alica.io/v1",
        "contract": {
          "descriptor": "descriptor.json",
          "digest": "sha256:191eacbb08f83239df26ad626e441dae370a372b8af1139af6191a08f5b0f69b",
          "identity": "io.alica.example.records",
          "version": "1.0.0"
        },
        "dependencies": [],
        "events": [],
        "kind": "CapabilityDefinition",
        "metadata": {
          "id": "acap://alica.io/example/records@1",
          "maturity": "experimental",
          "owner": "ALICA maintainers",
          "summary": "Bounded neutral text records with explicit absence and normal stop/start persistence.",
          "version": "1.0.0"
        },
        "permissions": [
          "example.records"
        ],
        "scopes": [
          "application",
          "session"
        ],
        "semantics": {
          "cancellation": "supported",
          "description": "Put replaces one key; get returns found false and empty value only for observed absence, never failure. Maximum32 records. A completed put survives normal stop/start of the service with the same operator-owned data directory. No crash durability, transactions, backup, migration or hostile-code confinement guarantee. See SEMANTICS.md.",
          "errors": [
            "INVALID_ARGUMENT",
            "PERMISSION_DENIED",
            "UNAVAILABLE",
            "CANCELLED",
            "DEADLINE_EXCEEDED",
            "RESOURCE_EXHAUSTED"
          ]
        }
      }
    ],
    "files": {
      "descriptor.json": {
        "features": [],
        "id": "io.alica.example.records",
        "operations": [
          {
            "idempotency": "none",
            "input": {
              "additionalProperties": false,
              "properties": {
                "key": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                "value": {
                  "maxLength": 4096,
