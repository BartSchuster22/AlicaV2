{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alica.invalid/specs/capability.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "acap.capability/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "kind": {
            "enum": [
              "unary",
              "stream"
            ]
          },
          "input": {
            "$ref": "#/$defs/payload"
          },
          "output": {
            "$ref": "#/$defs/payload"
          },
          "idempotency": {
            "enum": [
              "none",
              "provider"
            ]
          },
          "idempotencyPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "retentionMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "persistence": {
                "enum": [
                  "instance",
                  "durable"
                ]
              }
            },
            "required": [
              "retentionMs",
              "persistence"
            ]
          }
        },
        "required": [
          "name",
          "kind",
          "input",
          "output",
          "idempotency"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "idempotency": {
                  "const": "provider"
                }
              }
            },
            "then": {
              "required": [
                "idempotencyPolicy"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "idempotencyPolicy"
                ]
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 256
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "features",
    "operations"
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "integer",
            "boolean",
            "null"
          ]
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/payload"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "additionalProperties": {
          "const": false
        },
        "items": {
          "$ref": "#/$defs/payload"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minimum": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maximum": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "enum": {
          "type": "array",
          "items": {},
          "minItems": 1,
          "maxItems": 256
        },
        "const": {},
        "description": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "then": {
            "required": [
              "properties",
              "additionalProperties"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        }
      ]
    }
  }
}
