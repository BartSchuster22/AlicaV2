{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alica.invalid/specs/bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "alica.bundle/v1"
    },
    "bundleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "profileDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*)*$"
          },
          "digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "enum": [
              "runtime",
              "plugin",
              "descriptor",
              "manifest",
              "profile",
              "sbom",
              "provenance",
              "documentation"
            ]
          }
        },
        "required": [
          "path",
          "digest",
          "bytes",
          "kind"
        ]
      },
      "minItems": 1,
      "maxItems": 4096
    }
  },
  "required": [
    "schemaVersion",
    "bundleId",
    "profileDigest",
    "artifacts"
  ]
}
