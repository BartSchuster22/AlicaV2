{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alica.invalid/specs/plugin.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "alica.plugin/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
    },
    "execution": {
      "enum": [
        "inproc",
        "ipc"
      ]
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*)*$"
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capabilityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "descriptorDigest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "descriptorPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*)*$"
          }
        },
        "required": [
          "capabilityId",
          "version",
          "descriptorDigest",
          "descriptorPath"
        ]
      },
      "minItems": 0,
      "maxItems": 256
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capabilityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
          },
          "major": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "minMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][A-Za-z0-9]*$"
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          }
        },
        "required": [
          "capabilityId",
          "major",
          "minMinor",
          "operations",
          "features"
        ]
      },
      "minItems": 0,
      "maxItems": 256
    },
    "secretReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "publisher",
    "execution",
    "entrypoint",
    "provides",
    "requires",
    "secretReferences"
  ]
}
