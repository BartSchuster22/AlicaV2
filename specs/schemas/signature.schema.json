{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alica.invalid/specs/signature.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "ed25519"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  },
  "required": [
    "algorithm",
    "keyId",
    "signature"
  ]
}
