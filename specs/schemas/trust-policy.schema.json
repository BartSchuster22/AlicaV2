{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alica.invalid/specs/trust-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "alica.trust-policy/v1"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rootKeyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "publishers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
          },
          "keyIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "executionModes": {
            "type": "array",
            "items": {
              "enum": [
                "inproc",
                "ipc"
              ]
            },
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "keyIds",
          "executionModes"
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "expiresAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxOfflineAgeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "rootKeyIds",
    "publishers",
    "expiresAtMs",
    "maxOfflineAgeMs"
  ]
}
