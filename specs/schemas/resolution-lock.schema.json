{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alica.invalid/specs/resolution-lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "alica.resolution-lock/v1"
    },
    "profileDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policyDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "packageDigest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "packageDigest"
        ]
      },
      "maxItems": 256
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "consumerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "capabilityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
          },
          "providerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "descriptorDigest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "packageDigest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "consumerId",
          "scope",
          "capabilityId",
          "providerId",
          "version",
          "descriptorDigest",
          "packageDigest"
        ]
      },
      "maxItems": 256
    }
  },
  "required": [
    "schemaVersion",
    "profileDigest",
    "policyDigest",
    "plugins",
    "bindings"
  ]
}
