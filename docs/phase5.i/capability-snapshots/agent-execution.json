{"content":{"apiVersion":"catalog.alica.io/snapshot-v1","compatibility":{"rules":"catalog-v1-bounded","unknown":"REVIEW_REQUIRED"},"definitions":[{"apiVersion":"catalog.alica.io/v1","contract":{"descriptor":"proposals/agent-execution/descriptor.json","digest":"sha256:5dfa7277af5bfc57dec9e7bb49f7c33ebddc93fdb918afee9b0c3d26c8664940","identity":"io.alica.agent.execution","version":"1.0.0"},"dependencies":[],"events":[],"kind":"CapabilityDefinition","metadata":{"id":"acap://alica.io/agent/execution@1","maturity":"experimental","owner":"ALICA maintainers","summary":"Bounded provider-neutral request-scoped task execution.","version":"1.0.0"},"permissions":["agent.execute"],"scopes":["application","session"],"semantics":{"cancellation":"supported","description":"Executes a task in the documented provider-supported domain and returns its completed response text, not proof of correctness or a transcript. Unsupported tasks are INVALID_ARGUMENT. No persistent task state, resume, deduplication or automatic retries. Task text grants no tools, credentials, endpoints or scopes. Local cancellation bounds delivery and owned cleanup, not remote generation or billing.","errors":["INVALID_ARGUMENT","PERMISSION_DENIED","UNAVAILABLE","RESOURCE_EXHAUSTED","DEADLINE_EXCEEDED","CANCELLED","INTERNAL","FAILED_PRECONDITION"]}},{"apiVersion":"catalog.alica.io/v1","contract":{"descriptor":"capabilities/core/echo/descriptor.json","digest":"sha256:76c2818de1cef99248256d1e0ae2561be259d0175ee5b55b7e4dff686e35649d","identity":"io.alica.example.echo","version":"1.0.0"},"dependencies":[],"events":[],"kind":"CapabilityDefinition","metadata":{"id":"acap://alica.io/example/echo@1","maturity":"experimental","owner":"ALICA maintainers","summary":"Neutral bounded text round-trip for external-author contract interoperability.","version":"1.0.0"},"permissions":["example.echo"],"scopes":["application","session"],"semantics":{"cancellation":"supported","description":"Returns the supplied text unchanged. No side effects and no persistence or deduplication guarantee.","errors":["INVALID_ARGUMENT","CANCELLED","DEADLINE_EXCEEDED"]}}],"files":{"capabilities/core/echo/descriptor.json":{"features":[],"id":"io.alica.example.echo","operations":[{"idempotency":"none","input":{"additionalProperties":false,"properties":{"text":{"maxLength":4096,"type":"string"}},"required":["text"],"type":"object"},"kind":"unary","name":"echo","output":{"additionalProperties":false,"properties":{"text":{"maxLength":4096,"type":"string"}},"required":["text"],"type":"object"}}],"schemaVersion":"acap.capability/v1","version":"1.0.0"},"proposals/agent-execution/descriptor.json":{"features":[],"id":"io.alica.agent.execution","operations":[{"idempotency":"none","input":{"additionalProperties":false,"properties":{"task":{"maxLength":4096,"minLength":1,"type":"string"}},"required":["task"],"type":"object"},"kind":"unary","name":"execute","output":{"additionalProperties":false,"properties":{"text":{"maxLength":8192,"minLength":1,"type":"string"}},"required":["text"],"type":"object"}}],"schemaVersion":"acap.capability/v1","version":"1.0.0"}},"index":{"apiVersion":"catalog.alica.io/index-v1","entries":[{"digest":"sha256:5dfa7277af5bfc57dec9e7bb49f7c33ebddc93fdb918afee9b0c3d26c8664940","id":"acap://alica.io/agent/execution@1","identity":"io.alica.agent.execution","maturity":"experimental","version":"1.0.0"},{"digest":"sha256:76c2818de1cef99248256d1e0ae2561be259d0175ee5b55b7e4dff686e35649d","id":"acap://alica.io/example/echo@1","identity":"io.alica.example.echo","maturity":"experimental","version":"1.0.0"}],"version":"0.2.0"},"policy":{"apiVersion":"catalog.alica.io/namespace-v1","namespaces":[{"authority":"alica.io","domain":"example","kind":"first-party","owner":"ALICA maintainers"},{"authority":"alica.io","domain":"agent","kind":"first-party","owner":"ALICA maintainers"}],"release":["acap://alica.io/example/echo@1","acap://alica.io/agent/execution@1"],"version":"1.1.0"},"version":"0.2.0"},"digest":"sha256:98aa