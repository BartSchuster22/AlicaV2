{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alica.invalid/drafts/g6/context-offer.schema.json",
  "title": "G6 R2 native carrier packet; descriptor is ancillary, not a JSON value",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "acap.ipc-offer/v1"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "offerId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contextId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "purpose": {
      "enum": [
        "invoke",
        "lifecycle",
        "event",
        "provider-task"
      ]
    },
    "descriptorCount": {
      "const": 1
    },
    "remainingMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "generation",
    "offerId",
    "contextId",
    "purpose",
    "descriptorCount",
    "remainingMs"
  ]
}
