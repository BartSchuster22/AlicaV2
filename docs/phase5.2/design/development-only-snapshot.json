        "kind": "CapabilityDefinition",
        "metadata": {
          "id": "acap://alica.io/assurance/incidents@1",
          "maturity": "experimental",
          "owner": "ALICA maintainers",
          "summary": "Scoped assurance incident queries and attributable acknowledgement; no remediation authority.",
          "version": "1.0.0"
        },
        "permissions": [
          "assurance.read",
          "assurance.acknowledge"
        ],
        "scopes": [
          "application",
          "session"
        ],
        "semantics": {
          "cancellation": "supported",
          "description": "get/list/acknowledge only same-scope incidents under Host grants plus independently mapped local identity. Explicit acknowledge requestId retries are durable actor+scope bound; collisions conflict. Evidence-backed resolution only; no manual resolve or annotations. Signals are best-effort public typed events, broker provenance plus local target authorization required. Historical provenance confers no current authority. See ../DESIGN.md. Draft metadata is not review approval.",
          "errors": [
            "INVALID_ARGUMENT",
            "UNAUTHENTICATED",
            "PERMISSION_DENIED",
            "NOT_FOUND",
            "CONFLICT",
            "FAILED_PRECONDITION",
            "UNAVAILABLE",
            "RESOURCE_EXHAUSTED",
            "CANCELLED",
            "DEADLINE_EXCEEDED"
          ]
        }
      }
    ],
