        "kind": "CapabilityDefinition",
        "metadata": {
          "id": "acap://alica.io/orchestration/kanban@1",
          "maturity": "experimental",
          "owner": "ALICA maintainers",
          "summary": "Bounded Kanban documentary state and conservative lifecycle-event polling; no execution control.",
          "version": "1.0.0"
        },
        "permissions": [
          "kanban.read",
          "kanban.mutate"
        ],
        "scopes": [
          "application",
          "session"
        ],
        "semantics": {
          "cancellation": "supported",
          "description": "See ../DESIGN.md. Sole backend authority, public board mapping and trusted exact caller enforcement. Documentary triage create/title-body edit/comments only. Last-writer-wins, best-effort requestKey not native idempotency. Unknown writes never retried automatically; broker timeout/cancel also UNKNOWN mutation outcome. Events always continuity UNKNOWN, bounded pull, replay duplicates expected. No dispatch/control/dependencies or production adoption.",
          "errors": [
            "INVALID_ARGUMENT",
            "UNAUTHENTICATED",
            "PERMISSION_DENIED",
            "NOT_FOUND",
            "CONFLICT",
            "FAILED_PRECONDITION",
            "UNAVAILABLE",
            "RESOURCE_EXHAUSTED",
            "CANCELLED",
            "DEADLINE_EXCEEDED"
          ]
        }
      }
    ],
