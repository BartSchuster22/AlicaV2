        "kind": "CapabilityDefinition",
        "metadata": {
          "id": "acap://alica.io/memory/candidates@1",
          "maturity": "experimental",
          "owner": "ALICA maintainers",
          "summary": "Scoped durable working candidates with attributable provenance, stable IDs and bounded lexical retrieval.",
          "version": "1.0.0"
        },
        "permissions": [
          "memory.create-working",
          "memory.read",
          "memory.search"
        ],
        "scopes": [
          "application",
          "session"
        ],
        "semantics": {
          "cancellation": "supported",
          "description": "Create active/working author-only candidates; get/search only visible active/working records representable without truncation. Stable IDs and completed creates survive normal restart. Mandatory durable actor-key idempotency for create, at least24h retention. Host operation grants plus independently narrowed data authority; no actor/promotion/import authority in payload. Search records retrieval evidence; absence/outage distinct. See SEMANTICS.md.",
          "errors": [
            "INVALID_ARGUMENT",
            "UNAUTHENTICATED",
            "PERMISSION_DENIED",
            "NOT_FOUND",
            "CONFLICT",
            "FAILED_PRECONDITION",
            "UNAVAILABLE",
            "RESOURCE_EXHAUSTED",
            "CANCELLED",
            "DEADLINE_EXCEEDED"
          ]
        }
      }
    ],
