    "definitions": [
      {
        "apiVersion": "catalog.alica.io/v1",
        "contract": {
          "descriptor": "descriptor.json",
          "digest": "sha256:5de26137740ed9454b07de40970dfbac1af049aead5e29e29a7848ac3f33db08",
          "identity": "io.alica.memory.candidates",
