{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alica.io/catalog/capability-definition-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "contract",
    "semantics",
    "scopes",
    "permissions",
    "dependencies",
    "events"
  ],
  "properties": {
    "apiVersion": { "const": "catalog.alica.io/v1" },
    "kind": { "const": "CapabilityDefinition" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "maturity", "owner", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/uri" },
        "version": { "$ref": "#/$defs/version" },
        "maturity": {
          "enum": [
            "proposed",
            "experimental",
            "stable",
            "deprecated",
            "retired"
          ]
        },
        "owner": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptor", "identity", "version", "digest"],
      "properties": {
        "descriptor": { "$ref": "#/$defs/path" },
        "identity": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
        },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "cancellation", "errors"],
      "properties": {
        "description": { "$ref": "#/$defs/text" },
        "cancellation": { "enum": ["supported", "unsupported"] },
        "errors": { "$ref": "#/$defs/names" }
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["application", "session", "request"] }
    },
    "permissions": { "$ref": "#/$defs/names" },
    "dependencies": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "version", "required"],
        "properties": {
          "capability": { "$ref": "#/$defs/uri" },
          "version": {
            "type": "string",
            "pattern": "^\\^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "required": { "type": "boolean" }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["descriptor", "identity", "version", "digest"],
        "properties": {
          "descriptor": { "$ref": "#/$defs/path" },
          "identity": { "$ref": "#/$defs/text" },
          "version": { "$ref": "#/$defs/version" },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "uri": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^acap://[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[a-z][a-z0-9]*(?:-[a-z0-9]+)*@[1-9][0-9]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "path": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.json$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "names": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
        "maxLength": 128
      }
    }
  }
}
