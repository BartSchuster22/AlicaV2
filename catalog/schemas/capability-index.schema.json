{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alica.io/catalog/capability-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "version", "entries"],
  "properties": {
    "apiVersion": { "const": "catalog.alica.io/index-v1" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "maturity", "identity", "digest"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^acap://[a-z0-9.-]+/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*@[1-9][0-9]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "maturity": {
            "enum": ["experimental", "stable", "deprecated", "retired"]
          },
          "identity": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
