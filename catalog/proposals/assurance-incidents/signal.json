{
  "schemaVersion": "acap.event-descriptor/v1",
  "id": "io.alica.assurance.signal",
  "version": "1.0.0",
  "payload": {
    "type": "object",
    "properties": {
      "observationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "target": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "occurredAtMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "observedAtMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "signal": {
        "type": "string",
        "enum": [
          "FAIL",
          "RECOVER"
        ]
      },
      "evidence": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "CHECK_FAILED",
              "CHECK_RECOVERED",
              "HISTORICAL_CLASSIFICATION"
            ]
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
          "code",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "observationId",
      "target",
      "occurredAtMs",
      "observedAtMs",
      "signal",
      "evidence"
    ],
    "additionalProperties": false
  }
}
